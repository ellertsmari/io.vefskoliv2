# Add these to .env.local for the local Docker demo. Restart Next.js afterwards.
# Local development only; other computers cannot connect to this address.
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# For a shared classroom, use a hosted LiveKit server's wss:// URL and its
# credentials. Keep the API secret server-side; never use NEXT_PUBLIC_ for it.
